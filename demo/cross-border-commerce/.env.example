# 复制为 .env 并按需修改；.env 已被 .gitignore 忽略，不会进入版本库
BASE_URL=http://localhost:18080
ADMIN_USER=admin
ADMIN_PASS=admin
# 商家种子账号密码与用户名相同（alice/alice、bob/bob），脚本内置
#
# 如本机 18080 被其他服务占用，用独立端口组启动官方 dev 栈后在此覆盖：
#   cd agentscope-service
#   BUILDER_GATEWAY_PORT=28080 BUILDER_CONTROL_PORT=28081 \
#   BUILDER_DATA_PORT=28082 BUILDER_SCHEDULER_PORT=28083 BUILDER_PG_PORT=25432 \
#   BUILDER_REBUILD=1 scripts/dev-up.sh
#   # 然后把上面 BASE_URL 改为 http://localhost:28080

# 模型 Key 也必须注入 agentscope-service 进程；这里只供 demo 前置检查。
# DASHSCOPE_API_KEY=填写本地可用的Key
# XBD_MODEL=服务支持的provider:model（仅用于新建Agent）
